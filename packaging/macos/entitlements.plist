<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the signed, notarized Finger Mouse.app.

  camera                              the whole point: reading the webcam
  allow-unsigned-executable-memory    Python's ctypes (used for the macOS and
                                      Windows input APIs and by MediaPipe)
                                      creates small executable trampolines

  Controlling the pointer needs no entitlement: macOS asks the person to
  allow Finger Mouse under Privacy & Security → Accessibility instead.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
